# El dominio sale de .env (DOMAIN). Cambiar de VPS o de dominio = cambiar DNS y .env, sin tocar codigo.

# Cabeceras de seguridad comunes a todos los sitios
(seguridad) {
	header {
		# Solo HTTPS durante 1 ano (sin includeSubDomains/preload para no comprometer otros subdominios)
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# No revelar la version del servidor
		-Server
	}
}

# Panel 3D (estatico) + WebSocket MQTT + configuracion para el panel
{$DOMAIN} {
	import seguridad
	encode zstd gzip
	header {
		# Web Bluetooth y camara solo para este sitio; nada de microfono, geolocalizacion, etc.
		Permissions-Policy "bluetooth=(self), camera=(self), microphone=(self), geolocation=()"
		X-Frame-Options DENY
		Cache-Control "no-cache"
	}

	handle_path /mqtt* {
		reverse_proxy mosquitto:9001
	}
	handle /config.json {
		header Content-Type application/json
		respond `{"mqttHost":"mqtt.{$DOMAIN}","mqttPort":443,"tls":true}` 200
	}
	handle {
		root * /srv/panel
		file_server
	}
}

grafana.{$DOMAIN} {
	import seguridad
	encode zstd gzip
	reverse_proxy grafana:3000
}

# Solo existe para que Caddy obtenga el certificado que usa Mosquitto (llega por el 443 via SNI)
mqtt.{$DOMAIN} {
	# Compatibilidad con el cliente TLS del firmware ESP32-CAM.
	tls {
		key_type rsa2048
		issuer acme {
			disable_tlsalpn_challenge
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
	}
	import seguridad
	respond "mqtt ok" 200
}
