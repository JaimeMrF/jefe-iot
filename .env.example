# Copia este archivo a .env y cambia los valores. .env NO se sube a GitHub.
INFLUX_USER=admin
INFLUX_PASSWORD=cambia-esto-123456
INFLUX_ORG=jefe-iot
INFLUX_BUCKET=iot
INFLUX_TOKEN=cambia-este-token-largo

GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia-esto
PUBLIC_GRAFANA_URL=http://localhost:3000

# Token del tunel de Cloudflare (dia 2, cuando tengas dominio)
CLOUDFLARE_TUNNEL_TOKEN=

# Key de Azure Maps Weather (la del profesor)
AZURE_MAPS_KEY=

# Retencion de InfluxDB (solo se aplica al crear el volumen por primera vez). 0 = infinita
# INFLUX_RETENTION=90d

# --- Opcionales del bridge (los valores por defecto son seguros) ---
# LAT=4.711
# LON=-74.072
# LOG_LEVEL=info            # debug | info | warn | error
# LOG_FORMAT=text           # text | json
# REAL_TIMEOUT_S=90         # sin datos de la ESP32 real en este tiempo -> simulacion
# API_TIMEOUT_MS=10000
# API_RETRIES=2
# API_CACHE_MAX_S=1800      # reenvia el ultimo valor bueno (stale=1) hasta este tiempo
# EVENTS_MAX_PER_MIN=30
# HEALTH_PORT=8081          # GET /health interno (no se publica)

# --- Jefe v2: persistencia, zona horaria y Telegram (todo opcional) ---
# TZ=America/Bogota          # zona horaria de los reportes diarios/semanales
# Bot de Telegram: crealo con @BotFather (ver docs/DEPLOY.md). Sin token o sin chat_id, Telegram queda apagado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MIN_SEVERITY=warning   # info | warning | critical
# REPORT_HOUR=18                  # hora del reporte diario
# REPORT_WEEKDAY=5                # dia del reporte semanal (0=domingo ... 5=viernes)
