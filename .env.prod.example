# Plantilla de produccion. En el VPS vive en /opt/jefe-iot/.env (bootstrap.sh la genera con secretos aleatorios).
DOMAIN=ejemplo.com
ACME_EMAIL=

INFLUX_USER=admin
INFLUX_PASSWORD=cambia
INFLUX_ORG=jefe-iot
INFLUX_BUCKET=iot
INFLUX_TOKEN=cambia

GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia

MQTT_ESP_PASS=cambia
MQTT_PANEL_PASS=cambia
MQTT_BACKEND_PASS=cambia

AZURE_MAPS_KEY=

# Retencion de InfluxDB (solo al crear el volumen; en un servidor existente ver docs/DEPLOY.md)
# INFLUX_RETENTION=90d

# Opcionales del bridge: LAT, LON, LOG_LEVEL, LOG_FORMAT, REAL_TIMEOUT_S, API_TIMEOUT_MS, API_RETRIES,
# API_CACHE_MAX_S, EVENTS_MAX_PER_MIN (ver .env.example). Se pasan en docker-compose.prod.yml solo si se agregan alli.

# --- Jefe v2: persistencia, zona horaria y Telegram (todo opcional) ---
# TZ=America/Bogota          # zona horaria de los reportes diarios/semanales
# Bot de Telegram: crealo con @BotFather (ver docs/DEPLOY.md). Sin token o sin chat_id, Telegram queda apagado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MIN_SEVERITY=warning   # info | warning | critical
# REPORT_HOUR=18                  # hora del reporte diario
# REPORT_WEEKDAY=5                # dia del reporte semanal (0=domingo ... 5=viernes)
